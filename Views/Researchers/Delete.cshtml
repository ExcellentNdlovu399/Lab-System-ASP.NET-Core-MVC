@model Lab_System.Models.ResearcherProfile

<div class="card" style="max-width:520px;margin:40px auto;">

    <div class="card-header">
        <div class="card-title">
            Delete Profile
        </div>
    </div>

    <p>
        Are you sure you want to delete this profile?
    </p>

    <div class="mini-row">
        <div class="mini-key">Name</div>
        <div class="mini-val">
            @(Model.User?.FullName)
        </div>
    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="pill active">

            Confirm Delete

        </button>

        <a asp-action="Index"
           class="pill"
           style="text-decoration:none;">

            Cancel

        </a>

    </form>

</div>
