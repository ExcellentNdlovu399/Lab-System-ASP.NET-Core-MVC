<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Lab_System</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;500;600;700&family=DM+Sans:wght@300;400;500&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/labsystem.css"
          asp-append-version="true" />
</head>

<body>

    <partial name="_Sidebar" />

    <div class="main">

        <partial name="_Topbar" />

        <div class="content">
            @RenderBody()
        </div>

    </div>

    <script src="~/js/Lab_System.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
