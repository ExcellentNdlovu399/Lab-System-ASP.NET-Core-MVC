@model Lab_System.Models.ViewModels.LoginViewModel

<div class="card" style="max-width:420px;margin:80px auto;">
    <div class="card-header">
        <div class="card-title ">User Login</div>
    </div>

    <form asp-action="Login" method="post">
        <div class="filter-row">
            <input asp-for="Email"
                   class="filter-input"
                   placeholder="User email" />
        </div>

        <div class="filter-row">
            <input asp-for="Password"
                   class="filter-input"
                   placeholder="Password" />
        </div>

        <button type="submit" class="pill active">
            Login
        </button>

        <div asp-validation-summary="All"
             style="margin-top:14px;color:var(--accent3);font-size:12px;">
        </div>
    </form>
</div>
