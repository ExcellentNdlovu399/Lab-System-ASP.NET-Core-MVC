@model Lab_System.Models.ReactionStep

<div class="card" style="max-width:560px;margin:40px auto;">
    <div class="card-header">
        <div class="card-title">Delete Reaction Step</div>
    </div>

    <p style="color:var(--muted);font-size:13px;">
        Are you sure you want to delete this reaction step?
    </p>

    <div class="mini-row">
        <div class="mini-key">Step</div>
        <div class="mini-val">Step @Model.StepOrder</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Title</div>
        <div class="mini-val">@Model.StepTitle</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Experiment</div>
        <div class="mini-val">@Model.Experiment?.Title</div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:16px;">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="pill active">
            Confirm Delete
        </button>

        <a asp-controller="Dashboard"
           asp-action="Index"
           asp-route-tab="reactions"
           class="pill"
           style="text-decoration:none;">
            Cancel
        </a>
    </form>
</div>