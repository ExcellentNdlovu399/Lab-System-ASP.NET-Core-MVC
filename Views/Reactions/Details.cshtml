@model Lab_System.Models.ReactionStep

<div class="card" style="max-width:760px;margin:40px auto;">
    <div class="card-header">
        <div class="card-title">
            Step @Model.StepOrder — @Model.StepTitle
        </div>

        <span class="badge badge-purple">
            @Model.StepType
        </span>
    </div>

    <div class="mini-row">
        <div class="mini-key">Experiment</div>
        <div class="mini-val">@Model.Experiment?.Title</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Parent Step</div>
        <div class="mini-val">
            @(Model.ParentStep == null ? "Root step" : Model.ParentStep.StepTitle)
        </div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Temperature</div>
        <div class="mini-val">@Model.Temperature °C</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Pressure</div>
        <div class="mini-val">@Model.Pressure</div>
    </div>

    <div class="result-box">
        <div class="result-label">Reaction Equation</div>
        <div class="result-text">@Model.ReactionEquation</div>
    </div>

    <div class="result-box">
        <div class="result-label">Description</div>
        <div class="result-text">@Model.Description</div>
    </div>

    <div class="section-head">Child Steps</div>

    @if (Model.ChildSteps.Any())
    {
        foreach (var child in Model.ChildSteps)
        {
            <div class="mini-row">
                <div class="mini-key">Step @child.StepOrder</div>
                <div class="mini-val">@child.StepTitle</div>
            </div>
        }
    }
    else
    {
        <div class="empty">No child steps yet.</div>
    }

    <div class="tag-list" style="margin-top:18px;">
        <a asp-controller="Dashboard"
           asp-action="Index"
           asp-route-tab="reactions"
           class="tag"
           style="text-decoration:none;">
            Back
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Researcher"))
        {
            <a asp-controller="Reactions"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="tag"
               style="text-decoration:none;">
                Edit
            </a>
        }
    </div>
</div>