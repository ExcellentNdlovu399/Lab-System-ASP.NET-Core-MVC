@model Lab_System.Models.Chemicals

<div class="card" style="max-width:520px;margin:40px auto;">
    <div class="card-header">
        <div class="card-title">Delete Chemical</div>
    </div>

    <p style="color:var(--muted);font-size:13px;">
        Are you sure you want to delete this chemical?
    </p>

    <div class="mini-row">
        <div class="mini-key">Name</div>
        <div class="mini-val">@Model.Name</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Formula</div>
        <div class="mini-val">@Model.Formula</div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:16px;">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="pill active">
            Confirm Delete
        </button>

        <a asp-controller="Dashboard"
           asp-action="Index"
           asp-route-tab="chemicals"
           class="pill"
           style="text-decoration:none;">
            Cancel
        </a>
    </form>
</div>