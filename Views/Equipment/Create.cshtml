@model Lab_System.Models.Equipment

<div class="card" style="max-width:620px;margin:40px auto;">
    <div class="card-header">
        <div class="card-title">Add Equipment</div>
    </div>

    <form asp-action="Create" method="post">

        <div class="filter-row">
            <input asp-for="Name" class="filter-input" placeholder="Equipment name" />
        </div>

        <div class="filter-row">
            <input asp-for="Type" class="filter-input" placeholder="Type e.g. Analytical" />
        </div>

        <div class="filter-row">
            <input asp-for="Model" class="filter-input" placeholder="Model e.g. Hanna HI2211" />
        </div>

        <div class="filter-row">
            <input asp-for="SerialNumber" class="filter-input" placeholder="Serial number" />
        </div>

        <div class="filter-row">
            <select asp-for="Status" class="filter-input">
                <option value="">Select status</option>
                <option value="available">available</option>
                <option value="in use">in use</option>
                <option value="maintenance">maintenance</option>
                <option value="retired">retired</option>
            </select>
        </div>

        <div class="filter-row">
            <input asp-for="LastCalibrated" type="date" class="filter-input" />
        </div>

        <div class="filter-row">
            <input asp-for="HoursUsed" class="filter-input" placeholder="Hours used" />
        </div>

        <div class="filter-row">
            <input asp-for="Location" class="filter-input" placeholder="Location e.g. Lab Bench 2" />
        </div>

        <div class="filter-row">
            <input asp-for="Notes" class="filter-input" placeholder="Notes" />
        </div>

        <button type="submit" class="pill active">
            Save Equipment
        </button>

        <a asp-controller="Dashboard"
           asp-action="Index"
           asp-route-tab="equipment"
           class="pill"
           style="text-decoration:none;">
            Cancel
        </a>

        <div asp-validation-summary="All"
             style="margin-top:14px;color:var(--accent3);font-size:12px;">
        </div>
    </form>
</div>
