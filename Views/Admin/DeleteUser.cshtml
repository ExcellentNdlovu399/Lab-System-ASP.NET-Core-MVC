@model Lab_System.Models.ApplicationUser

<div class="card" style="max-width:520px;margin:40px auto;">
    <div class="card-header">
        <div class="card-title">Delete User</div>
    </div>

    <p style="color:var(--muted);font-size:13px;">
        Are you sure you want to delete this user?
    </p>

    <div class="mini-row">
        <div class="mini-key">Full Name</div>
        <div class="mini-val">@Model.FullName</div>
    </div>

    <div class="mini-row">
        <div class="mini-key">Email</div>
        <div class="mini-val">@Model.Email</div>
    </div>

    <form asp-action="DeleteUser" method="post" style="margin-top:16px;">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="pill active">
            Confirm Delete
        </button>
    </form>
</div>