                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="tag"
                           style="text-decoration:none;">
                            Edit
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Researchers"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="tag"
                           style="text-decoration:none;">
                            Delete
                        </a>
                    }
                </div>
            </div>
        }
    </div>

</div>